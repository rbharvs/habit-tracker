# Copy to .env and fill in your values
# Get your IP: curl ifconfig.me

# Cloudflare IPs (https://www.cloudflare.com/ips/) + YOUR_IP
ALLOWED_IPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32,YOUR_IPV4/32,YOUR_IPV6/64

# Custom domain (from Cloudflare)
DOMAIN_NAME=habits.yourdomain.com

# ACM certificate ARN (create in AWS Certificate Manager, us-east-1)
CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID

# AWS profile for local deploys (assumes HabitTrackerDeployRole)
# Configure in ~/.aws/config:
#   [profile habit-tracker-deploy]
#   role_arn = arn:aws:iam::ACCOUNT_ID:role/HabitTrackerDeployRole
#   source_profile = default
AWS_PROFILE=habit-tracker-deploy
